---
// components
import DefaultLayout from '../layouts/DefaultLayout.astro';
import Toolbar from '../components/toolbar.astro';
import Card from "../components/Card.astro"

// content
import { getCollection } from 'astro:content';
import statusData from '../data/status.json';

// methods
const allTools = await getCollection('tools');
const sortedTools = allTools.sort((a, b) =>
  b.data.title - a.data.title
);

function resolveStatus(id: string, fallback: string) {
  const liveCheck = statusData[id]
  if (!liveCheck) return fallback
  return liveCheck.statusCode !== null && liveCheck.statusCode >= 200 && liveCheck.statusCode < 300 ? 'live' : 'down'
}
---

<DefaultLayout>
	<section class="flow span-content has-pb-xl has-pt-s">
		<p class="has-size-3 has-text-balance has-max-width-5">
			Hier findest du eine Sammlung an nützlichen <span class="has-color-accent">Tools, Websites & Ressourcen</span> die am Fachbereich genutzt werden.
		</p>
	</section>
	<section class="subgrid has-items-stretch span-content" id="tools-grid">
		{sortedTools.map((tool) => (
			<Card
				title={tool.data.title}
				description={tool.data.description}
				url={tool.data.url}
				author={tool.data.author}
				status={resolveStatus(tool.id, tool.data.status)}
				tags={tool.data.tags}
				audience={tool.data.audience}
				internal={tool.data.internal}
				addedAt={tool.data.addedAt.toDateString()}
				screenshot={`/screenshots/${tool.id}.jpg`}
			/>
		))}
	</section>
	<section class="subgrid span-full has-py-2xl has-mt-xl">
		<div class="flow span-content has-items-center">
			<h3 class="has-size-3 has-max-width-5 has-text-center">
				Hier fehlt ein Tool?
			</h3>
			<p class="has-size-5 has-text-center has-max-width-6">
				Reiche jetzt dein von dir entwickeltes Tool ein oder verweise auf diese Seite, damit andere Nutzer*innen fehlende Tools melden können.
			</p>
			<div class="flow-row has-justify-center has-gap-xs has-mt-s">
				<a href="https://github.com/lex-zander/hsbi-tools/issues/new?template=tool-submission.yml" target="_blank" class="button is-primary">
					Tool einreichen
				</a>
			</div>
		</div>
	</section>
</DefaultLayout>