---
// components
import Toolbar from './toolbar.astro';
---

<footer class="flow-row span-content has-py-m">
    <ol class="flow-row has-gap-xs">
        <li>
            <a href="/impressum" class="has-size-8 has-text-uppercase">Impressum</a>
        </li>
        <li>
            <a href="/datenschutz" class="has-size-8 has-text-uppercase">Datenschutzbestimmungen</a>
        </li>
    </ol>
    <Toolbar />
</footer>

<style>
    footer {
        ol {
            li {
                a {
                    color: var(--color-neutral-600);
                    transition: all 0.2s ease-out;

                    &:hover,
                    &:focus {
                        color: var(--color-white);
                    }
                }
            }
        }
    }
</style>