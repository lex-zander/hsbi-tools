---
// components
import Indicator from "./Indicator.astro";

// props
const {
  title,
  url,
  description,
  author,
  status,
  tags,
  audience,
  internal,
  addedAt,
  screenshot,
} = Astro.props;
---

<article class="card span-6" style={screenshot ? `--screenshot: url('${screenshot}')` : ''}>
    <a
        class="card__link"
        href={url}
        target="_blank"
        title={title}
        aria-label={title}>
    </a>
    <header class="card__header">
        <div class="card__header__indicator">
            <Indicator
                {status}
            />
        </div>
        <h2>{title}</h2>
    </header>
    <div class="card__content">
        <p>{description}</p>
    </div>
    <footer class="card__footer">
        <p>entwickelt von <strong>{author}</strong></p>
    </footer>
</article>

<style>
    .card {
        aspect-ratio: 16/9;
        background-color: oklch(0.08 0.01 var(--color-accent-h));
        background-image:
            linear-gradient(
                to top,
                oklch(0.08 0.01 var(--color-accent-h)) 0%,
                transparent 65%
            ),
            var(--screenshot, none);
        background-size: cover;
        background-position: center top;
        border-radius: var(--border-radius);
        color: var(--color-white);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding-inline: var(--space-s);
        padding-block: var(--space-xs);
        position: relative;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;

        &:hover,
        &:focus {
            background-color: oklch(0.12 0.01 var(--color-accent-h));
            box-shadow:
                0 0 0 1px color-mix(in srgb, var(--color-accent) 60%, transparent),
                0 0 24px color-mix(in srgb, var(--color-accent) 35%, transparent);
        }

        .card__link {
            position: absolute;
            inset: 0;
        }

        .card__header {
            .card__header__indicator {
                position: absolute;
                top: 0.5em;
                right: 0.5em;
            }

            h2 {
                font-size: var(--font-size-5);
            }
        }

        .card__content {
            margin-top: var(--space-xs);

            p {
                font-size: var(--font-size-6);
            }
        }

        .card__footer {
            border-top: 1px solid color-mix(in srgb, var(--color-white) 20%, transparent);
            display: flex;
            justify-content: flex-end;
            margin-top: var(--space-xs);
            padding-top: var(--space-xs);

            p {
                font-size: var(--font-size-8);
                color: color-mix(in srgb, var(--color-white) 60%, transparent);
            }
        }
    }
</style>